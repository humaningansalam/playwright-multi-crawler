[Unit]
Description=Playwright Multi Crawler
Wants=network-online.target
After=network-online.target graphical.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=playwright-crawler
WorkingDirectory=/opt/playwright-multi-crawler
EnvironmentFile=/opt/playwright-multi-crawler/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/playwright-multi-crawler/.venv/bin/python -m src.main
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
